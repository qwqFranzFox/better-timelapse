# One style for every file, so a change never mixes formatting with behaviour.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ndk-build reads these, and make cares about tabs.
[Makefile]
indent_style = tab
[*.mk]
indent_style = tab

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_size = 2
